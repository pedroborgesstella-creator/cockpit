# Exemplo de variáveis secretas do Cockpit.
# Copie este arquivo para .env e preencha com seus valores.
# NÃO commiteie o .env no GitHub.

# Gmail (envio e leitura)
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app-do-google

# Google Calendar (futuro)
GOOGLE_CALENDAR_CREDENTIALS=credenciais.json